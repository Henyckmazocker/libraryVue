# Production Environment Configuration

# Application
APP_NAME=LibraryVue
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-production-domain.com

# API Configuration
API_URL=https://api.your-production-domain.com
API_VERSION=v1

# Database
DB_CONNECTION=mysql
DB_HOST=prod_db_host
DB_PORT=3306
DB_DATABASE=library_db
DB_USERNAME=library_user
DB_PASSWORD=secure_production_password

# Google OAuth
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret

# JWT Configuration
JWT_SECRET=very_secure_production_jwt_secret_key
JWT_EXPIRATION=3600

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-production-domain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-CSRF-Token

# Logging
LOG_LEVEL=warning
LOG_CHANNEL=file
LOG_PATH=/var/log/libraryvue

# Session
SESSION_LIFETIME=7200
SESSION_NAME=libraryvue_session

# Security
CSRF_TOKEN_NAME=csrf_token
CSRF_TOKEN_EXPIRATION=3600

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=json,csv,txt

# Frontend specific
VUE_APP_API_URL=https://api.your-production-domain.com/index.php
VUE_APP_GOOGLE_CLIENT_ID=your_production_google_client_id
