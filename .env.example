# Ejemplo de archivo de configuración de entorno
# Copia este archivo a .env.development o .env.production y ajusta los valores

# Application
APP_NAME=LibraryVue
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# API Configuration
API_URL=http://localhost:8888
API_VERSION=v1

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=library_db
DB_USERNAME=library_user
DB_PASSWORD=library_pass

# Google OAuth
GOOGLE_CLIENT_ID=909299522196-mgusvnrk8t6j2odsf1lo4octc3i9t4vg.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=3600

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-CSRF-Token

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=file
LOG_PATH=/var/log/libraryvue

# Session
SESSION_LIFETIME=7200
SESSION_NAME=libraryvue_session

# Security
CSRF_TOKEN_NAME=csrf_token
CSRF_TOKEN_EXPIRATION=3600

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=json,csv,txt
