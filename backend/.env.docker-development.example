# ============================================================================
# DOCKER DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================================================
# This file is used by docker-compose.yml for development
# Copy this to .env.docker-development and configure
# ============================================================================

# Application
APP_ENV=development
APP_DEBUG=true

# Database (Docker service names)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=library_db
DB_USERNAME=library_user
DB_PASSWORD=dev_password_change_me

# Catalog mirror (docker-compose.mirror.yml) — a SEPARATE server, shared with
# the production stack. Its own user because a MySQL server has one password per
# user and library_user's differs between environments. Every DB_MIRROR_* falls
# back to its app equivalent above, so a single-server deployment still works.
DB_MIRROR_HOST=mirror-mysql
DB_MIRROR_PORT=3306
DB_MIRROR_DATABASE=library_mirror
DB_MIRROR_USERNAME=library_mirror_user
DB_MIRROR_PASSWORD=mirror_dev
# Importer only (backend/bin/mirror). Separate because LOAD DATA INFILE needs
# the FILE privilege, which is global and cannot be scoped to one schema.
DB_MIRROR_IMPORT_USER=library_mirror_importer
DB_MIRROR_IMPORT_PASSWORD=mirror_import_dev

# MySQL Root
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_PASSWORD=dev_password_change_me

# Google OAuth - Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Books API
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# JWT
JWT_SECRET=development_jwt_secret_min_32_chars_here
JWT_EXPIRE=3600

# Logging
LOG_PATH=/var/www/html/storage/logs
LOG_LEVEL=debug

# Spotify API - Get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# TMDB (MOVIES / SERIES)
# Replaces OMDb: OmdbService no longer exists. Titles come from the local mirror
# (library_mirror); TMDB only enriches the detail page and is cached in
# tmdb_title. Free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Last.fm API - Get from https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key

# YouTube Data API v3 - Get from https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_data_api_key

# CORS - Allow frontend dev server
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://127.0.0.1:8888

# Rate limiting - global default per IP (login/proxies use stricter overrides)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MINUTES=1
