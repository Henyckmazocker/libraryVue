# ============================================================================
# LIBRARY VUE - BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and configure with your actual values
# NEVER commit .env file to version control
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_NAME="Library Vue"

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# REQUIRED: Database connection settings
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=library_db
DB_USERNAME=library_user
DB_PASSWORD=your_secure_password_here

# MySQL Root Password (for Docker setup)
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_PASSWORD=your_secure_password_here

# ----------------------------------------------------------------------------
# GOOGLE OAUTH AUTHENTICATION
# ----------------------------------------------------------------------------
# REQUIRED: Get these from Google Cloud Console
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google Books API (optional - for book metadata enrichment)
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# ----------------------------------------------------------------------------
# IGDB API (TWITCH GAMING DATABASE)
# ----------------------------------------------------------------------------
# REQUIRED for Games feature: Get these from Twitch Developers
# https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=your_igdb_client_id_here
IGDB_CLIENT_SECRET=your_igdb_client_secret_here

# ----------------------------------------------------------------------------
# SPOTIFY API (MUSIC CATALOG)
# ----------------------------------------------------------------------------
# REQUIRED for Music feature: Get these from Spotify Developer Dashboard
# https://developer.spotify.com/dashboard
# Uses Client Credentials Flow (no user login required)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ----------------------------------------------------------------------------
# LAST.FM API (LISTENING STATISTICS)
# ----------------------------------------------------------------------------
# REQUIRED for Music listening stats: Get API key from Last.fm
# https://www.last.fm/api/account/create
# No OAuth required — only API key + user's Last.fm username
LASTFM_API_KEY=your_lastfm_api_key_here

# ----------------------------------------------------------------------------
# JWT TOKEN CONFIGURATION
# ----------------------------------------------------------------------------
# REQUIRED: Generate a secure random string
# Use: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_min_32_characters
JWT_EXPIRE=3600

# ----------------------------------------------------------------------------
# SESSION CONFIGURATION
# ----------------------------------------------------------------------------
SESSION_LIFETIME=7200
SESSION_DOMAIN=
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# ----------------------------------------------------------------------------
# CORS CONFIGURATION
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# For production, use your actual domain:
# CORS_ALLOWED_ORIGINS=https://library.yourdomain.com

# ----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------------------------
LOG_CHANNEL=app
LOG_LEVEL=debug
LOG_PATH=./storage/logs
LOG_MAX_FILES=7
LOG_CONSOLE=true
LOG_JSON_FORMAT=false

# Per-channel log levels
LOG_LEVEL_APP=debug
LOG_LEVEL_API=info
LOG_LEVEL_DATABASE=info
LOG_LEVEL_AUTH=info
LOG_LEVEL_SECURITY=warning
LOG_LEVEL_APPLICATION=info
LOG_LEVEL_FRONTEND=info

# ----------------------------------------------------------------------------
# RATE LIMITING (future implementation)
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MINUTES=1

# ----------------------------------------------------------------------------
# FILE UPLOAD CONFIGURATION
# ----------------------------------------------------------------------------
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf

# ----------------------------------------------------------------------------
# CACHE CONFIGURATION (future implementation)
# ----------------------------------------------------------------------------
CACHE_DRIVER=file
CACHE_TTL=3600

# Redis (if using)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null
# REDIS_DB=0

# ----------------------------------------------------------------------------
# MONITORING & ERROR TRACKING (optional)
# ----------------------------------------------------------------------------
# SENTRY_DSN=your_sentry_dsn_here
# NEW_RELIC_LICENSE_KEY=your_newrelic_key_here

# ============================================================================
# PRODUCTION SECURITY CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
# ✓ APP_ENV=production
# ✓ APP_DEBUG=false
# ✓ Strong unique passwords for DB_PASSWORD and MYSQL_ROOT_PASSWORD
# ✓ Secure random JWT_SECRET (min 32 characters)
# ✓ SESSION_SECURE=true (requires HTTPS)
# ✓ CORS_ALLOWED_ORIGINS set to production domain only
# ✓ LOG_LEVEL=warning or error
# ✓ All credentials are kept secret and never committed to git
# ============================================================================
