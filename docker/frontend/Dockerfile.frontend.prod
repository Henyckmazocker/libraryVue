# Stage 1: Build the Vue.js application
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package.json and package-lock.json
COPY frontend/package.json frontend/package-lock.json* ./

# Install ALL dependencies (needed for build)
# --legacy-peer-deps needed for @codetrix-studio/capacitor-google-auth (declares peer @capacitor/core@^6, project uses ^8)
RUN npm install --legacy-peer-deps

# Copy the rest of the application source code
COPY frontend/src ./src
COPY frontend/public ./public
COPY frontend/babel.config.js .
COPY frontend/jsconfig.json .
COPY frontend/vue.config.js .

# Set the API URL for the production build
# This will be overridden at build time from docker-compose.prod.yml
# Las cuatro que este build recibe como args. VUE_APP_MODE es del build de
# Capacitor, que no pasa por aquí, y VUE_APP_AUGUR_VERSION/VUE_APP_AUGUR_BUILD
# no son args: las calcula vue.config.js (src/augur/stamp.cjs) dentro del
# npm run build. La de OMDb se retiró con OmdbService: las películas las sirve
# el mirror y a TMDB llama el backend, así que ninguna clave de catálogo viaja
# ya al bundle.
#
# Augur (src/analytics/index.js): sin VUE_APP_AUGUR_KEY el SDK no se configura,
# así que una clave vacía es el interruptor de apagado. La write_key es pública
# por diseño; el compose la toma de AUGUR_KEY en .env.prod y el endpoint de
# AUGUR_ENDPOINT (por defecto el Augur de prod). Un endpoint vacío cae al
# default de index.js.
ARG VUE_APP_API_URL
ARG VUE_APP_GOOGLE_CLIENT_ID
ARG VUE_APP_AUGUR_KEY
ARG VUE_APP_AUGUR_ENDPOINT
ENV VUE_APP_API_URL=${VUE_APP_API_URL}
ENV VUE_APP_GOOGLE_CLIENT_ID=${VUE_APP_GOOGLE_CLIENT_ID}
ENV VUE_APP_AUGUR_KEY=${VUE_APP_AUGUR_KEY}
ENV VUE_APP_AUGUR_ENDPOINT=${VUE_APP_AUGUR_ENDPOINT}

# Build the application (outputs to /app/dist by default in vue.config.js)
RUN npm run build

# Stage 2: Serve the application with Nginx
FROM nginx:1.25-alpine

# Remove default Nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy the production Nginx configuration
COPY docker/nginx/nginx.prod.conf /etc/nginx/conf.d/default.conf

# Create nginx user and set permissions
RUN chown -R nginx:nginx /usr/share/nginx/html \
    && chmod -R 755 /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"] 