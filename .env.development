# Development Environment Configuration

# Application
APP_NAME=LibraryVue
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# API Configuration
API_URL=http://localhost:8888
API_VERSION=v1

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=library_db
DB_USERNAME=library_user
DB_PASSWORD=library_pass
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# Google OAuth
GOOGLE_CLIENT_ID=909299522196-mgusvnrk8t6j2odsf1lo4octc3i9t4vg.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# JWT Configuration
JWT_SECRET=dev_jwt_secret_key_not_for_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800
JWT_ISSUER=libraryVue
JWT_AUDIENCE=libraryVue-users

# Sesiones
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_COOKIE=libraryVue_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-CSRF-Token
CORS_MAX_AGE=86400

# Seguridad
BCRYPT_ROUNDS=10
SECURITY_KEY=your-security-key-for-development

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_STACK=single

# Cache
CACHE_DRIVER=file
CACHE_PREFIX=libraryVue

# Archivos y subidas
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf
UPLOAD_PATH=storage/uploads

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
API_MAX_ATTEMPTS=60
API_DECAY_MINUTES=1

# Características opcionales
TWO_FACTOR_ENABLED=false
REQUIRE_EMAIL_VERIFICATION=false

# Security
CSRF_TOKEN_NAME=csrf_token
CSRF_TOKEN_EXPIRATION=3600

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=json,csv,txt

# Frontend specific
VUE_APP_API_URL=http://localhost:8888/index.php
VUE_APP_GOOGLE_CLIENT_ID=909299522196-mgusvnrk8t6j2odsf1lo4octc3i9t4vg.apps.googleusercontent.com