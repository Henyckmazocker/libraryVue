# ============================================================================
# LIBRARY VUE - DOCKER COMPOSE ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and configure with your actual values
# This file is used by docker-compose.yml and docker-compose.prod.yml
# NEVER commit .env file to version control
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------------------------------------------
APP_NAME=LibraryVue
APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

# ----------------------------------------------------------------------------
# API CONFIGURATION
# ----------------------------------------------------------------------------
API_URL=http://127.0.0.1:8888
API_VERSION=v1

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# IMPORTANT: Change passwords to strong, unique values in production
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=library_db
# ---- Mirror de catálogos (docker-compose.mirror.yml) -----------------------
# El mirror es un SERVIDOR APARTE, compartido por los stacks de dev y de prod:
# son 2,2 GB de catálogo público (IMDb + MusicBrainz) y dos cachés con cuota
# ajena, y duplicarlo por entorno costaría el doble de todo. Cada DB_MIRROR_*
# cae a su equivalente de arriba si no se declara, así que un despliegue de un
# solo servidor sigue funcionando sin tocar nada.
DB_MIRROR_HOST=mirror-mysql
DB_MIRROR_PORT=3306
DB_MIRROR_DATABASE=library_mirror
# Usuario propio, y no library_user: un servidor MySQL tiene UNA contraseña por
# usuario, y la de library_user en dev no es la de producción. Lo crea el
# entrypoint de docker-compose.mirror.yml.
DB_MIRROR_USERNAME=library_mirror_user
DB_MIRROR_PASSWORD=CHANGE_ME_mirror_password
# Usuario del importador. Aparte del anterior porque LOAD DATA INFILE exige el
# privilegio FILE, que solo existe global (ON *.*): dárselo al usuario con el
# que la app web consulta el mirror ampliaría el alcance de una inyección SQL.
# Solo lo usa backend/bin/mirror. Lo crea `./mirror-sync.sh --bootstrap`.
DB_MIRROR_IMPORT_USER=library_mirror_importer
DB_MIRROR_IMPORT_PASSWORD=CHANGE_ME_mirror_import_password
DB_USERNAME=library_user
DB_PASSWORD=CHANGE_ME_strong_password_here

# MySQL Root Password (for Docker MySQL container)
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password_here
MYSQL_PASSWORD=CHANGE_ME_strong_password_here

# ----------------------------------------------------------------------------
# GOOGLE OAUTH AUTHENTICATION
# ----------------------------------------------------------------------------
# REQUIRED: Get these from Google Cloud Console
# https://console.cloud.google.com/
# NOTE: The example ID below is for demonstration only - replace with yours
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google Books API (optional - for book metadata)
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# TMDB — capa de enriquecimiento del mirror (sinopsis, póster y director).
# Gratuita en https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ----------------------------------------------------------------------------
# SPOTIFY API (MUSIC CATALOG)
# ----------------------------------------------------------------------------
# REQUIRED for Music feature: Get from Spotify Developer Dashboard
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ----------------------------------------------------------------------------
# LAST.FM API (LISTENING STATISTICS)
# ----------------------------------------------------------------------------
# REQUIRED for Music listening stats: Get from Last.fm
# https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# YouTube Data API v3 (video search)
# REQUIRED for YouTube video search: Get from https://console.cloud.google.com/
# Enable YouTube Data API v3, then create an API key (no OAuth required)
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# ----------------------------------------------------------------------------
# JWT CONFIGURATION
# ----------------------------------------------------------------------------
# REQUIRED: Generate a secure random string (min 32 characters)
# Use command: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_secure_random_jwt_secret_min_32_chars
JWT_EXPIRATION=3600

# ----------------------------------------------------------------------------
# CORS CONFIGURATION
# ----------------------------------------------------------------------------
# For development
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-CSRF-Token

# For production, use only your domain:
# CORS_ALLOWED_ORIGINS=https://library.yourdomain.com

# ----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_CHANNEL=file
LOG_PATH=/var/log/libraryvue

# ----------------------------------------------------------------------------
# SESSION CONFIGURATION
# ----------------------------------------------------------------------------
SESSION_LIFETIME=7200
SESSION_NAME=libraryvue_session

# Production settings (enable for production):
# SESSION_SECURE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=Strict

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
CSRF_TOKEN_NAME=csrf_token
CSRF_TOKEN_EXPIRATION=3600

# ----------------------------------------------------------------------------
# FILE UPLOAD
# ----------------------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=json,csv,txt

# ============================================================================
# PRODUCTION SECURITY CHECKLIST
# ============================================================================
# Before deploying to production:
# ✓ Set APP_ENV=production
# ✓ Set APP_DEBUG=false
# ✓ Change ALL passwords to strong, unique, random values
# ✓ Generate secure JWT_SECRET with: openssl rand -base64 32
# ✓ Update GOOGLE_CLIENT_ID with production credentials
# ✓ Set CORS_ALLOWED_ORIGINS to production domain only
# ✓ Enable SESSION_SECURE=true (requires HTTPS)
# ✓ Set LOG_LEVEL=warning or error
# ✓ Keep .env file secret and never commit to git
# ============================================================================
