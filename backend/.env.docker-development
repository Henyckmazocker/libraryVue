# Configuración para Docker
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC

# Configuración de logging para Docker
LOG_CHANNEL=app
LOG_LEVEL=debug
LOG_PATH=/var/www/html/storage/logs
LOG_MAX_FILES=7
LOG_CONSOLE=true
LOG_JSON_FORMAT=false

# Configuración específica por canal
LOG_LEVEL_APP=debug
LOG_LEVEL_API=debug
LOG_LEVEL_DATABASE=info
LOG_LEVEL_AUTH=debug
LOG_LEVEL_SECURITY=warning
LOG_LEVEL_APPLICATION=debug

# Configuración de base de datos para Docker
DB_HOST=mysql
DB_DATABASE=library_db
DB_USERNAME=library_user
DB_PASSWORD=library_pass
DB_PORT=3306

# Configuración de Google OAuth
GOOGLE_CLIENT_ID=909299522196-mgusvnrk8t6j2odsf1lo4octc3i9t4vg.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Configuración JWT
JWT_SECRET=docker_development_jwt_secret_key
JWT_EXPIRE=3600

# CORS para Docker
CORS_ALLOWED_ORIGINS=http://localhost:8080
