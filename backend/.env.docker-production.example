# ============================================================================
# DOCKER PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# This file is used by docker-compose.prod.yml for production
# Copy this to .env.docker-production and configure with SECURE values
# NEVER use default/example passwords in production!
# ============================================================================

# Application - PRODUCTION SETTINGS
APP_ENV=production
APP_DEBUG=false

# Database (Docker service names)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=library_db_prod
DB_USERNAME=library_user
DB_PASSWORD=CHANGE_TO_STRONG_RANDOM_PASSWORD

# MySQL Root - MUST BE CHANGED
MYSQL_ROOT_PASSWORD=CHANGE_TO_STRONG_RANDOM_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_TO_STRONG_RANDOM_PASSWORD

# Google OAuth - Production credentials
# Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_production_google_client_secret

# Google Books API
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# Spotify API - Production credentials
# Get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_production_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_production_spotify_client_secret

# Last.fm API
# Get from https://www.last.fm/api/account/create
LASTFM_API_KEY=your_production_lastfm_api_key

# OMDb API (MOVIES / SERIES)
# Get API key from: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# YouTube Data API v3
# Get from https://console.cloud.google.com/ → YouTube Data API v3
YOUTUBE_API_KEY=your_production_youtube_data_api_key

# JWT - MUST BE SECURE RANDOM STRING (min 32 chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_TO_SECURE_RANDOM_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRE=3600

# Logging - Production settings
LOG_PATH=/var/www/html/storage/logs
LOG_LEVEL=warning

# CORS - Production domain only
CORS_ALLOWED_ORIGINS=https://library.yourdomain.com

# Session Security - PRODUCTION
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Strict

# ============================================================================
# SECURITY CHECKLIST FOR PRODUCTION
# ============================================================================
# ✓ All passwords are strong and unique
# ✓ JWT_SECRET is securely generated random string
# ✓ CORS_ALLOWED_ORIGINS contains ONLY production domain
# ✓ APP_DEBUG is false
# ✓ LOG_LEVEL is warning or error
# ✓ SESSION_SECURE is true (requires HTTPS)
# ✓ This file is NOT committed to git
# ============================================================================
